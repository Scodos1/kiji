# Django
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Set DJANGO_ENV=production to force DEBUG=False and enable HTTPS hardening.
DJANGO_ENV=development
# Required origins for the frontend over HTTPS, e.g. https://app.kiji.test
# CSRF_TRUSTED_ORIGINS=https://app.kiji.test

# PostgreSQL (optional — SQLite is used for local dev by default)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API rate limits (per IP, unless noted)
# RATE_LIMIT_ANON=120/hour   # anonymous (non-auth) requests
# RATE_LIMIT_USER=2000/hour  # authenticated requests
# RATE_LIMIT_AUTH=20/minute  # login/register per IP

# AI / LLM provider (optional — without a key the AI uses rule-based insights)
# Supports OpenAI-compatible APIs. Examples:
#   OpenAI:     LLM_API_KEY=sk-...   (LLM_MODEL=gpt-4o-mini)
#   OpenRouter: LLM_API_KEY=sk-or-...  LLM_BASE_URL=https://openrouter.ai/api/v1
#   Groq:       LLM_API_KEY=gsk_...    LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Free tier AI query cap per user per month
AI_FREE_MONTHLY_QUERIES=5

# Error monitoring (optional — set a DSN to enable Sentry)
# SENTRY_DSN=https://your-dsn@sentry.io/123
