# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Set DJANGO_ENV=production to force DEBUG=False and enable HTTPS hardening.
DJANGO_ENV=development
# Set to a random string to hide /admin/ behind a secret URL segment in production
# ADMIN_SECRET_KEY=your-random-admin-secret

# PostgreSQL (optional — SQLite is used for local dev by default)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# CORS (comma-separated origins) — in production, set to your actual domain(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required in production for CSRF to work with your frontend domain
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# API rate limits (per IP, unless noted)
RATE_LIMIT_ANON=60/hour
RATE_LIMIT_USER=1000/hour
RATE_LIMIT_AUTH=10/minute

# AI / LLM provider (optional — without a key the AI uses rule-based insights)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# Free tier AI query cap per user per month
AI_FREE_MONTHLY_QUERIES=5

# Billing — Paystack (optional — mock mode when blank)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Error monitoring (optional — set a DSN to enable Sentry)
SENTRY_DSN=
